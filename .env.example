# Glow Scents environment variables
NODE_ENV=development
SESSION_SECRET=generate-a-long-random-secret-before-production

# Store owner and email delivery
OWNER_EMAIL=owner@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@example.com
SMTP_PASS=your-provider-app-password

# Optional WhatsApp contact number; numbers only
WA_NUMBER=2348000000000

# Required before Vercel production deployment:
# DATABASE_URL=postgresql://...
# SESSION_STORE_URL=...
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_WEBHOOK_SECRET=...
